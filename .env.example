# Assessment extractor: offline baseline or local Ollama. .env is not auto-loaded.
SPECTRO_AI_PROVIDER=baseline
SPECTRO_AI_CONTEXT=16384
SPECTRO_AI_TIMEOUT=120
SPECTRO_AI_OUTPUT_TOKENS=2048
# Set provider to ollama for local structured extraction; unavailable Ollama
# visibly falls back to the offline extractor.

# Independent document Q&A provider: ollama or openai.
SPECTRO_RAG_PROVIDER=ollama
SPECTRO_RAG_INDEX=.cache/rag/index.sqlite3
SPECTRO_RAG_CONTEXT=4096
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:12b-it-q4_K_M
OLLAMA_EMBED_MODEL=qwen3-embedding:0.6b

# RAG OpenAI-compatible endpoint must support Chat Completions JSON-object mode.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=
OPENAI_API_KEY=
