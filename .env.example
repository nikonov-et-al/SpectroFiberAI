# Assessment provider: ollama (default) or openai. .env is not auto-loaded.
SPECTRO_AI_PROVIDER=ollama
SPECTRO_AI_CONTEXT=16384
SPECTRO_AI_TIMEOUT=240
SPECTRO_AI_OUTPUT_TOKENS=4096
# Both extraction and assessment require selected LLM. No offline fallback.

# Shared assessment knowledge index; embeddings always use Ollama.
SPECTRO_RAG_INDEX=.cache/rag/index.sqlite3
SPECTRO_RAG_CONTEXT=4096
SPECTRO_RAG_CHUNK_SIZE=1200
SPECTRO_RAG_CHUNK_OVERLAP=180
SPECTRO_RAG_EVIDENCE_COUNT=8
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:12b-it-q4_K_M
OLLAMA_EMBED_MODEL=qwen3-embedding:0.6b

# Assessment requires strict JSON-schema output support.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=
OPENAI_API_KEY=
